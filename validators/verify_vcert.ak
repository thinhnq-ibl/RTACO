use bls.{Sign}
use cardano/transaction.{OutputReference, Transaction, placeholder}
use request.{IssueProof, OpenProof, Vcert, request_cred}

pub type Datum {
  iproof: IssueProof,
  open: OpenProof,
  vcerts: List<Vcert>,
  cm_compressed: ByteArray,
  h_compressed: ByteArray,
  hs_compressed: List<ByteArray>,
  include_indexes: List<List<Int>>,
}

validator verify_vcert {
  spend(
    datum: Option<Data>,
    _redeemer: Data,
    _utxo: OutputReference,
    _self: Transaction,
  ) {
    expect Some(data) = datum
    expect Datum {
      iproof,
      open,
      vcerts,
      cm_compressed,
      h_compressed,
      hs_compressed,
      include_indexes,
    } = data
    request_cred(
      iproof,
      open,
      vcerts,
      cm_compressed,
      h_compressed,
      hs_compressed,
      include_indexes,
    )
  }

  else(_) {
    fail
  }
}

