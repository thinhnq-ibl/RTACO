use bls.{Sign}
use cardano/transaction.{OutputReference, Transaction, placeholder}
use rtaco.{IssueProof, Vcert, request_cred}

pub type Datum {
  iproof: IssueProof,
  vcerts: List<Vcert>,
  cm_compressed: ByteArray,
  h_compressed: ByteArray,
  hs_compressed: List<ByteArray>,
  include_indexes: List<List<Int>>,
}

validator verify_vcert {
  spend(
    datum: Option<Data>,
    _redeemer: Data,
    _utxo: OutputReference,
    _self: Transaction,
  ) {
    expect Some(data) = datum
    expect Datum {
      iproof,
      vcerts,
      cm_compressed,
      h_compressed,
      hs_compressed,
      include_indexes,
    } = data
    request_cred(
      iproof,
      vcerts,
      cm_compressed,
      h_compressed,
      hs_compressed,
      include_indexes,
    )
  }

  else(_) {
    fail
  }
}

test verify_vcert_test() {
  let iproof =
    IssueProof {
      c: 1829593992231171916144607694336687776587727305534619392069631031201006552,
      rr: 51839363151237656070248670753499709298136810258042750562515006465879236500834,
      ros: [
        49526502970626326190734162209754307568752095715801894020470445954841935684831,
        13249756855650621780667634673027739974381154503128457364046544621087872573025,
        13248690420869082244328517396061705708695303566629199883252177328640741512047,
        28592730922529532138702679339822792530176409550368574921869049823182402014598,
      ],
