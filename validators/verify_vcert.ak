use bls.{Sign}
use cardano/transaction.{OutputReference, Transaction, placeholder}
use request.{IssueProof, Vcert, request_cred}

pub type Datum {
  iproof: IssueProof,
  vcerts: List<Vcert>,
  cm_compressed: ByteArray,
  h_compressed: ByteArray,
  hs_compressed: List<ByteArray>,
  include_indexes: List<List<Int>>,
  aw: List<ByteArray>,
  bw: ByteArray,
  cw: List<ByteArray>,
}

validator verify_vcert {
  spend(
    datum: Option<Data>,
    _redeemer: Data,
    _utxo: OutputReference,
    _self: Transaction,
  ) {
    expect Some(data) = datum
    expect Datum {
      iproof,
      vcerts,
      cm_compressed,
      h_compressed,
      hs_compressed,
      include_indexes,
      aw,
      bw,
      cw,
    } = data
    request_cred(
      iproof,
      vcerts,
      cm_compressed,
      h_compressed,
      hs_compressed,
      include_indexes,
      aw,
      bw,
      cw,
    )
  }

  else(_) {
    fail
  }
}
